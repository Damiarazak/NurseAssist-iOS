    </mxCell>

    <mxCell id="63" value="Firebase Storage&#xa;──────────────────────&#xa;Path: wound_images/{uid}/{fileName}&#xa;Format: image/jpeg&#xa;Pre-upload compression:&#xa;  resize → max 1024px longest side&#xa;  re-encode at 85% JPEG quality&#xa;Returns download URL&#xa;  stored in WoundAssessment.imageUrl" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=8.5;align=left;spacingLeft=5;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
