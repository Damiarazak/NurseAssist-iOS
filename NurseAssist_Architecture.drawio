    <mxCell id="51" value="① SkinDetectionService.containsSkin()&#xa;─────────────────────────────────&#xa;Package: google_mlkit_selfie_segmentation ^0.10.1&#xa;SelfieSegmenter(mode: SegmenterMode.single)&#xa;InputImage.fromFilePath(imageFile.path)&#xa;Counts pixels with confidence &gt; 0.5&#xa;Ratio &lt; 4%  →  NoWoundDetectedException&#xa;               'No skin detected'&#xa;ML Kit error  →  allow through (permissive)&#xa;segmenter.close() in finally block" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=8.5;align=left;spacingLeft=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
      <mxGeometry x="55" y="718" width="385" height="135" as="geometry" />
    </mxCell>

    <mxCell id="52" value="② WoundAnalysisService._analyzeWithTFLite()&#xa;─────────────────────────────────────────&#xa;Package: tflite_flutter ^0.12.1&#xa;Model: assets/models/wound_classifier.tflite&#xa;Labels: assets/models/wound_labels.txt&#xa;Interpreter.fromAsset() — cached after first load&#xa;Input:  [1, 224, 224, 3]  float32  pixels 0-255&#xa;         (EfficientNetB0 normalises internally)&#xa;interpreter.run(input, output)&#xa;Output: [1, 8]  float32  softmax probabilities&#xa;Argmax → typeId (1-8), confidence&#xa;confidence &lt; 0.35 → NoWoundDetectedException&#xa;                     'No wound detected'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=8.5;align=left;spacingLeft=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
      <mxGeometry x="455" y="718" width="420" height="160" as="geometry" />
    </mxCell>

    <mxCell id="53" value="Fallback Methods (if TFLite fails or method switched):&#xa;  'cloud'  → Roboflow classify API (requires .env key + network)&#xa;  'enhanced_mock'  → HSV colour heuristics (redness, darkness ratios)&#xa;NoWoundDetectedException always re-thrown (never swallowed into fallback)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9b3e8;strokeColor=#9673a6;fontSize=8.5;align=left;spacingLeft=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
      <mxGeometry x="55" y="863" width="820" height="100" as="geometry" />
