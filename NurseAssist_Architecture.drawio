    </mxCell>

    <mxCell id="34" value="SkinDetectionService&#xa;────────────────────&#xa;containsSkin(imageFile): bool&#xa;  → SelfieSegmenter(SegmenterMode.single)&#xa;  → InputImage.fromFilePath()&#xa;  → processImage() → SegmentationMask&#xa;  → count pixels with confidence &gt; 0.5&#xa;  → ratio &lt; 0.04 → reject (no skin)&#xa;  → error → allow through (permissive)&#xa;  → segmenter.close() in finally" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=8.5;align=left;spacingLeft=5;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
