# Environment Variables for NurseAssist
# IMPORTANT: This file contains example/placeholder values only
# Copy this file to .env and add your actual API keys

# ==========================================================
# ROBOFLOW API CONFIGURATION
# ==========================================================
# Get your API key from: https://app.roboflow.com/settings/api
# After training your model, update these values

ROBOFLOW_API_KEY=your_actual_api_key_here
ROBOFLOW_WORKSPACE=your-workspace-name
ROBOFLOW_PROJECT=wound-classification
ROBOFLOW_VERSION=1

# ==========================================================
# OTHER API KEYS (if needed later)
# ==========================================================
# GOOGLE_CLOUD_API_KEY=your_key_here
# AZURE_PREDICTION_KEY=your_key_here
# AWS_ACCESS_KEY=your_key_here
