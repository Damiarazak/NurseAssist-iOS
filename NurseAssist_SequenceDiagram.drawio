    <!-- 1. Nurse taps Capture -->
    <mxCell id="m1" value="tap 'Capture Wound'" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#6c8ebf;strokeWidth=2;fontColor=#333;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1">
