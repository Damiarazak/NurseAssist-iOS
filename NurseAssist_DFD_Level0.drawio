<mxfile host="app.diagrams.net">
  <diagram id="DFD_L0" name="Page-1">
    <mxGraphModel dx="1300" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="750" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ═══════════════ TITLE ═══════════════ -->
        <mxCell id="title" value="NurseAssist — Data Flow Diagram (Level 0 / Context Diagram)"
          style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=17;fontStyle=1;"
          vertex="1" parent="1">
          <mxGeometry x="100" y="14" width="900" height="30" as="geometry" />
        </mxCell>

        <!-- ═══════════════ EXTERNAL ENTITIES ═══════════════ -->

        <!-- Nurse -->
        <mxCell id="eNurse" value="&lt;b&gt;Nurse&lt;/b&gt;"
          style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333;strokeColor=#444;strokeWidth=3;fontSize=14;"
          vertex="1" parent="1">
          <mxGeometry x="55" y="300" width="150" height="70" as="geometry" />
        </mxCell>

        <!-- Supervisor / Admin -->
        <mxCell id="eSuper" value="&lt;b&gt;Supervisor /&#xa;Admin&lt;/b&gt;"
          style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333;strokeColor=#444;strokeWidth=3;fontSize=14;"
          vertex="1" parent="1">
          <mxGeometry x="895" y="300" width="150" height="70" as="geometry" />
        </mxCell>

        <!-- Firebase Cloud (external system) -->
        <mxCell id="eFirebase" value="&lt;b&gt;Firebase Cloud&lt;/b&gt;&#xa;Firebase Auth · Firestore · Storage"
          style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;fontColor=#5d1515;strokeColor=#b85450;strokeWidth=2.5;fontSize=11;"
          vertex="1" parent="1">
          <mxGeometry x="420" y="568" width="260" height="60" as="geometry" />
        </mxCell>

        <!-- ═══════════════ CENTRAL PROCESS ═══════════════ -->
        <mxCell id="p0" value="&lt;b style='font-size:18px;'&gt;0&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b style='font-size:14px;'&gt;NurseAssist System&lt;/b&gt;"
          style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=3;fontSize=13;"
          vertex="1" parent="1">
          <mxGeometry x="355" y="245" width="390" height="180" as="geometry" />
        </mxCell>

        <!-- ═══════════════ DATA FLOWS ═══════════════ -->

        <!-- Nurse → System: credentials + data (upper lane) -->
        <mxCell id="f1" value="Login credentials · Patient details · Wound photo"
          style="edgeStyle=orthogonalEdgeStyle;strokeColor=#444;strokeWidth=2;fontSize=9;fontStyle=1;
                 exitX=1;exitY=0.3;exitPerimeter=0;entryX=0;entryY=0.3;entryPerimeter=0;"
          edge="1" source="eNurse" target="p0" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- System → Nurse: results (lower lane) -->
        <mxCell id="f2" value="Care plan · Assessment results · Error alerts"
          style="edgeStyle=orthogonalEdgeStyle;strokeColor=#6c8ebf;strokeWidth=2;fontSize=9;fontStyle=1;
                 exitX=0;exitY=0.72;exitPerimeter=0;entryX=1;entryY=0.72;entryPerimeter=0;"
          edge="1" source="p0" target="eNurse" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Supervisor → System: login + approvals (upper lane) -->
        <mxCell id="f3" value="Login credentials · Approval / Rejection decisions"
          style="edgeStyle=orthogonalEdgeStyle;strokeColor=#444;strokeWidth=2;fontSize=9;fontStyle=1;
                 exitX=0;exitY=0.3;exitPerimeter=0;entryX=1;entryY=0.3;entryPerimeter=0;"
          edge="1" source="eSuper" target="p0" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- System → Supervisor: pending queue + records (lower lane) -->
        <mxCell id="f4" value="Pending assessments list · Patient records"
          style="edgeStyle=orthogonalEdgeStyle;strokeColor=#6c8ebf;strokeWidth=2;fontSize=9;fontStyle=1;
                 exitX=1;exitY=0.72;exitPerimeter=0;entryX=0;entryY=0.72;entryPerimeter=0;"
          edge="1" source="p0" target="eSuper" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- System → Firebase: outbound (left lane going down) -->
        <mxCell id="f5" value="Wound images · Assessment records · Auth requests"
          style="edgeStyle=orthogonalEdgeStyle;strokeColor=#444;strokeWidth=2;fontSize=9;fontStyle=1;
                 exitX=0.38;exitY=1;exitPerimeter=0;entryX=0.28;entryY=0;entryPerimeter=0;"
          edge="1" source="p0" target="eFirebase" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Firebase → System: inbound (right lane going up) -->
        <mxCell id="f6" value="Auth tokens · Download URLs · Stored records"
          style="edgeStyle=orthogonalEdgeStyle;strokeColor=#b85450;strokeWidth=2;fontSize=9;fontStyle=1;
                 exitX=0.72;exitY=0;exitPerimeter=0;entryX=0.62;entryY=1;entryPerimeter=0;"
          edge="1" source="eFirebase" target="p0" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ═══════════════ LEGEND ═══════════════ -->
        <mxCell id="leg_bg" value=""
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bbb;strokeWidth=1;"
          vertex="1" parent="1">
          <mxGeometry x="30" y="590" width="300" height="120" as="geometry" />
        </mxCell>
        <mxCell id="leg_title" value="&lt;b&gt;Legend&lt;/b&gt;"
          style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontStyle=1;"
          vertex="1" parent="1">
          <mxGeometry x="38" y="596" width="280" height="18" as="geometry" />
        </mxCell>
        <mxCell id="leg_ee" value="External Entity"
          style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#444;strokeWidth=2.5;fontSize=10;"
          vertex="1" parent="1">
          <mxGeometry x="38" y="620" width="120" height="28" as="geometry" />
        </mxCell>
        <mxCell id="leg_p" value="Process"
          style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=10;"
          vertex="1" parent="1">
          <mxGeometry x="175" y="616" width="140" height="36" as="geometry" />
        </mxCell>
        <mxCell id="leg_arrow1" value=""
          style="edgeStyle=orthogonalEdgeStyle;strokeColor=#444;strokeWidth=2;endArrow=block;endFill=1;"
          edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="40" y="668" as="sourcePoint" />
            <mxPoint x="130" y="668" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="leg_l1" value="Data flow (in)"
          style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=10;"
          vertex="1" parent="1">
          <mxGeometry x="135" y="658" width="100" height="18" as="geometry" />
        </mxCell>
        <mxCell id="leg_arrow2" value=""
          style="edgeStyle=orthogonalEdgeStyle;strokeColor=#6c8ebf;strokeWidth=2;endArrow=block;endFill=1;"
          edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="40" y="690" as="sourcePoint" />
            <mxPoint x="130" y="690" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="leg_l2" value="Data flow (out)"
          style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=10;"
          vertex="1" parent="1">
          <mxGeometry x="135" y="681" width="100" height="18" as="geometry" />
        </mxCell>

        <!-- Subtitle note -->
        <mxCell id="note1" value="Note: On-device ML (TFLite · MediaPipe) runs entirely inside the NurseAssist System — no external ML API call."
          style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=9;fontStyle=2;fontColor=#666;"
          vertex="1" parent="1">
          <mxGeometry x="100" y="720" width="900" height="18" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
